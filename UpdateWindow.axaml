<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Assets_Editor.UpdateWindow"
        Title="Update available" Width="620" Height="520" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <TextBlock Grid.Row="0" x:Name="HeadlineText" FontSize="20" FontWeight="Bold"
                   Text="A new version is available"/>
        <TextBlock Grid.Row="1" x:Name="VersionText" Classes="dim" Margin="0,4,0,10" TextWrapping="Wrap"/>

        <Border Grid.Row="2" Classes="card" Padding="0">
            <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0" Spacing="4">
            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" IsVisible="False" Height="8"/>
            <TextBlock x:Name="StatusText" Classes="dim" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SkipButton" Content="Skip this version" Click="Skip_Click"/>
                <Button x:Name="GitHubButton" Content="Open on GitHub" Click="GitHub_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="LaterButton" Content="Later" Click="Later_Click"/>
                <Button x:Name="UpdateButton" Content="Update now" Classes="Primary" IsDefault="True" Click="Update_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
