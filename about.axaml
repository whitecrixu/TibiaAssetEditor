<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Assets_Editor.AboutWindow"
        Title="About" Height="200" Width="400"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Tibia Asset Editor" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="By WhiteCrixu" FontSize="16" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        <TextBlock x:Name="VersionText" Text="V1.0" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        <TextBlock Text="Cross-platform Tibia Assets Editor (Avalonia UI)" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.7"/>
    </StackPanel>
</Window>
