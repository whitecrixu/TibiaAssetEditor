<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="Assets_Editor.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <!-- Semi.Avalonia: modern theme with rounded corners, nicer focus rings,
             and a better dark mode than the default Fluent one. The resource
             class lives at the DLL root, hence the simple avares:// URI. -->
        <StyleInclude Source="avares://Semi.Avalonia/Index.axaml" />

        <!-- Project-wide design tokens + global control styles (spacing, radii,
             typography, Card / panelHeader / hero classes). Loaded after Semi
             so our selectors win for app-specific classes. -->
        <StyleInclude Source="avares://Tibia MultiTool Editor/Resources/Theme.axaml" />
    </Application.Styles>
</Application>
