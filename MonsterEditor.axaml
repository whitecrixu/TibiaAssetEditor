<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        x:Class="Assets_Editor.MonsterEditor"
        Title="Monster Editor"
        Width="1250" Height="820"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="Mica,AcrylicBlur,Blur">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Toolbar -->
        <Border Grid.Row="0" Classes="appbar">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="tool" i:Attached.Icon="fa-folder-open"  Content="Load folder…"  Click="LoadFolder_Click"/>
                <Button Classes="tool primary" i:Attached.Icon="fa-floppy-disk" Content="Save current" Click="SaveCurrent_Click"/>
                <Button Classes="tool" i:Attached.Icon="fa-floppy-disk" Content="Save all" Click="SaveAll_Click"/>
                <Separator Width="1" Margin="4,0"/>
                <Button Classes="tool" i:Attached.Icon="fa-plus"    Content="New Monster" Click="AddNew_Click"/>
                <Button Classes="tool" i:Attached.Icon="fa-clone"   Content="Duplicate"   Click="Duplicate_Click"/>
                <Button Classes="tool" i:Attached.Icon="fa-trash"   Content="Delete"      Click="Delete_Click"/>
                <Separator Width="1" Margin="4,0"/>
                <Button Classes="tool" i:Attached.Icon="fa-wand-magic-sparkles"
                        Content="Auto-fill Bestiary/Bosstiary"
                        ToolTip.Tip="Fill Bestiary for non-boss, Bosstiary for rewardBoss=true"
                        Click="AutoFill_Click"/>
                <Separator Width="1" Margin="4,0"/>
                <TextBlock x:Name="PathText" VerticalAlignment="Center" Classes="dim"/>
            </StackPanel>
        </Border>

        <!-- Split: list | detail -->
        <Grid Grid.Row="1" ColumnDefinitions="340,*">
            <!-- List -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <TextBox Grid.Row="0" x:Name="SearchBox" Watermark="Search by name or raceId…"
                         Margin="6" TextChanged="SearchBox_TextChanged"/>
                <ListBox Grid.Row="1" x:Name="MonsterList"
                         SelectionChanged="MonsterList_SelectionChanged"
                         ContainerPrepared="MonsterList_ContainerPrepared"
                         ContainerClearing="MonsterList_ContainerClearing"
                         Margin="6,0,6,6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,4">
                                <Border Classes="spriteSlot" Width="40" Height="40">
                                    <Image Source="{Binding Image}" Width="38" Height="38"
                                           RenderOptions.BitmapInterpolationMode="None"/>
                                </Border>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding RaceId}" FontSize="11" Opacity="0.6"/>
                                        <TextBlock Text="{Binding BestiaryClass}" FontSize="10" Opacity="0.55"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Detail tabs -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="8">
                <Border Grid.Row="0" Classes="hero">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="spriteSlot" Width="80" Height="80">
                            <Image x:Name="HeaderImage" Width="76" Height="76"
                                   RenderOptions.BitmapInterpolationMode="None"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="HeaderText" Text="No selection"
                                       FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock x:Name="HeaderHint" Classes="dim"
                                       Text="Load a monster folder (e.g. data-otservbr-global/monster) or ➕ create a new one."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TabControl Grid.Row="1" Margin="0,8,0,0">
                    <!-- Basic -->
                    <TabItem Header="Basic">
                        <ScrollViewer Padding="8" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="140,*,20,140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="NameBox" TextChanged="Field_Text"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Race ID" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="4" x:Name="RaceIdBox" Minimum="0" Maximum="99999999" FormatString="0" ValueChanged="Field_Num"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" x:Name="DescriptionBox" Margin="0,4,0,0" TextChanged="Field_Text"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Health" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="HealthBox" Minimum="0" Maximum="999999999" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Max Health" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="4" x:Name="MaxHealthBox" Minimum="0" Maximum="999999999" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Experience" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="ExperienceBox" Minimum="0" Maximum="999999999" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="Speed" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="3" Grid.Column="4" x:Name="SpeedBox" Minimum="0" Maximum="9999" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Corpse (item id)" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="CorpseBox" Minimum="0" Maximum="99999" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="Mana Cost" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="4" Grid.Column="4" x:Name="ManaCostBox" Minimum="0" Maximum="99999" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Race (blood type)" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="RaceBox" Margin="0,4,0,0" SelectionChanged="Field_Sel">
                                        <ComboBoxItem Content="blood"/>
                                        <ComboBoxItem Content="venom"/>
                                        <ComboBoxItem Content="undead"/>
                                        <ComboBoxItem Content="fire"/>
                                        <ComboBoxItem Content="energy"/>
                                        <ComboBoxItem Content="ink"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Outfit -->
                    <TabItem Header="Outfit">
                        <ScrollViewer Padding="8" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="140,*,20,140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="lookType" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="LookTypeBox" Minimum="0" Maximum="99999" FormatString="0" ValueChanged="Field_Num"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="lookTypeEx (item id)" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="4" x:Name="LookTypeExBox" Minimum="0" Maximum="99999" FormatString="0" ValueChanged="Field_Num"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="lookHead" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="LookHeadBox" Minimum="0" Maximum="132" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="lookBody" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="4" x:Name="LookBodyBox" Minimum="0" Maximum="132" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="lookLegs" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="LookLegsBox" Minimum="0" Maximum="132" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="lookFeet" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="4" x:Name="LookFeetBox" Minimum="0" Maximum="132" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="lookAddons" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="LookAddonsBox" Minimum="0" Maximum="3" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="lookMount" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="3" Grid.Column="4" x:Name="LookMountBox" Minimum="0" Maximum="99999" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Flags -->
                    <TabItem Header="Flags">
                        <ScrollViewer Padding="8" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <WrapPanel>
                                    <CheckBox x:Name="SummonableCb"     Content="summonable"      MinWidth="180" Margin="2,2" IsCheckedChanged="Field_Bool"/>
                                    <CheckBox x:Name="AttackableCb"     Content="attackable"      MinWidth="180" Margin="2,2" IsCheckedChanged="Field_Bool"/>
                                    <CheckBox x:Name="HostileCb"        Content="hostile"         MinWidth="180" Margin="2,2" IsCheckedChanged="Field_Bool"/>
                                    <CheckBox x:Name="ConvinceableCb"   Content="convinceable"    MinWidth="180" Margin="2,2" IsCheckedChanged="Field_Bool"/>
                                    <CheckBox x:Name="PushableCb"       Content="pushable"        MinWidth="180" Margin="2,2" IsCheckedChanged="Field_Bool"/>
                                    <CheckBox x:Name="RewardBossCb"     Content="rewardBoss"      MinWidth="180" Margin="2,2" IsCheckedChanged="Field_Bool"/>
                                    <CheckBox x:Name="IllusionableCb"   Content="illusionable"    MinWidth="180" Margin="2,2" IsCheckedChanged="Field_Bool"/>
                                    <CheckBox x:Name="CanPushItemsCb"   Content="canPushItems"    MinWidth="180" Margin="2,2" IsCheckedChanged="Field_Bool"/>
                                    <CheckBox x:Name="CanPushCreaturesCb" Content="canPushCreatures" MinWidth="180" Margin="2,2" IsCheckedChanged="Field_Bool"/>
                                    <CheckBox x:Name="HealthHiddenCb"   Content="healthHidden"    MinWidth="180" Margin="2,2" IsCheckedChanged="Field_Bool"/>
                                    <CheckBox x:Name="CanWalkOnEnergyCb" Content="canWalkOnEnergy" MinWidth="180" Margin="2,2" IsCheckedChanged="Field_Bool"/>
                                    <CheckBox x:Name="CanWalkOnFireCb"  Content="canWalkOnFire"   MinWidth="180" Margin="2,2" IsCheckedChanged="Field_Bool"/>
                                    <CheckBox x:Name="CanWalkOnPoisonCb" Content="canWalkOnPoison" MinWidth="180" Margin="2,2" IsCheckedChanged="Field_Bool"/>
                                </WrapPanel>
                                <Grid ColumnDefinitions="160,*,20,160,*" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Static Attack Chance" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="StaticAttackBox" Minimum="0" Maximum="100" FormatString="0" ValueChanged="Field_Num"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Target Distance" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="4" x:Name="TargetDistanceBox" Minimum="0" Maximum="10" FormatString="0" ValueChanged="Field_Num"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Run Health" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="RunHealthBox" Minimum="0" Maximum="999999" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Bestiary -->
                    <TabItem Header="Bestiary">
                        <ScrollViewer Padding="8" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <CheckBox x:Name="HasBestiaryCb" Content="Has Bestiary entry"
                                          IsCheckedChanged="Field_Bool"/>
                                <Grid ColumnDefinitions="140,*,20,140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Class" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="BestiaryClassBox"
                                               Watermark="Dragon / Demon / Reptile / …" TextChanged="Field_Text"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Race constant" VerticalAlignment="Center"/>
                                    <TextBox   Grid.Row="0" Grid.Column="4" x:Name="BestiaryRaceBox"
                                               Watermark="BESTY_RACE_DRAGON / …" TextChanged="Field_Text"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="To kill" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="BestiaryToKillBox" Minimum="0" Maximum="999999" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Stars" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="4" x:Name="BestiaryStarsBox" Minimum="0" Maximum="5" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="First Unlock" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="BestiaryFirstBox" Minimum="0" Maximum="999999" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Second Unlock" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="4" x:Name="BestiarySecondBox" Minimum="0" Maximum="999999" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Charms Points" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="BestiaryCharmsBox" Minimum="0" Maximum="999" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="Occurrence" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <NumericUpDown Grid.Row="3" Grid.Column="4" x:Name="BestiaryOccurrenceBox" Minimum="0" Maximum="5" FormatString="0" Margin="0,4,0,0" ValueChanged="Field_Num"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Locations" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" x:Name="BestiaryLocationsBox"
                                               AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4,0,0" TextChanged="Field_Text"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Bosstiary -->
                    <TabItem Header="Bosstiary">
                        <ScrollViewer Padding="8" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <CheckBox x:Name="HasBosstiaryCb" Content="Has Bosstiary entry (reward boss)"
                                          IsCheckedChanged="Field_Bool"/>
                                <Grid ColumnDefinitions="140,*,20,140,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Boss Race ID" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="BossRaceIdBox" Minimum="0" Maximum="99999" FormatString="0" ValueChanged="Field_Num"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Rarity" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="4" x:Name="BossRarityBox" SelectionChanged="Field_Sel">
                                        <ComboBoxItem Content="RARITY_BANE"/>
                                        <ComboBoxItem Content="RARITY_ARCHFOE"/>
                                        <ComboBoxItem Content="RARITY_NEMESIS"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock FontSize="11" Opacity="0.7"
                                           Text="Rarity hint: Bane (HP &lt; 10k), Archfoe (10k–50k), Nemesis (50k+)."/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Raw blocks -->
                    <TabItem Header="Raw Blocks">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Margin="8,8,8,4" FontSize="11" Opacity="0.7"
                                       Text="Complex blocks are kept verbatim. Edit as Lua table syntax; blank = use default."/>
                            <TabControl Grid.Row="1" Margin="8">
                                <TabItem Header="loot">        <TextBox x:Name="RawLootBox"        AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" TextChanged="Field_Text"/></TabItem>
                                <TabItem Header="attacks">     <TextBox x:Name="RawAttacksBox"     AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" TextChanged="Field_Text"/></TabItem>
                                <TabItem Header="defenses">    <TextBox x:Name="RawDefensesBox"    AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" TextChanged="Field_Text"/></TabItem>
                                <TabItem Header="elements">    <TextBox x:Name="RawElementsBox"    AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" TextChanged="Field_Text"/></TabItem>
                                <TabItem Header="immunities">  <TextBox x:Name="RawImmunitiesBox"  AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" TextChanged="Field_Text"/></TabItem>
                                <TabItem Header="voices">      <TextBox x:Name="RawVoicesBox"      AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" TextChanged="Field_Text"/></TabItem>
                                <TabItem Header="light">       <TextBox x:Name="RawLightBox"       AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" TextChanged="Field_Text"/></TabItem>
                                <TabItem Header="events">      <TextBox x:Name="RawEventsBox"      AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" TextChanged="Field_Text"/></TabItem>
                                <TabItem Header="changeTarget"><TextBox x:Name="RawChangeTargetBox" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" TextChanged="Field_Text"/></TabItem>
                                <TabItem Header="strategiesTarget"><TextBox x:Name="RawStrategiesBox" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" TextChanged="Field_Text"/></TabItem>
                                <TabItem Header="summons">     <TextBox x:Name="RawSummonBox"      AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" TextChanged="Field_Text"/></TabItem>
                            </TabControl>
                        </Grid>
                    </TabItem>

                    <!-- Preview -->
                    <TabItem Header="Preview Lua">
                        <Grid RowDefinitions="Auto,*" Margin="8">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                <Button Content="🔄 Refresh" Click="RefreshPreview_Click"/>
                                <TextBlock Text="Read-only view of what will be written to disk."
                                           VerticalAlignment="Center" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <TextBox Grid.Row="1" x:Name="PreviewBox" AcceptsReturn="True"
                                     TextWrapping="NoWrap" IsReadOnly="True" FontFamily="monospace"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Classes="statusbar">
            <TextBlock x:Name="StatusText" Classes="dim" Text="Ready"/>
        </Border>
    </Grid>
</Window>
