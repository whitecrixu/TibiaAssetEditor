<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Assets_Editor.SheetSizePicker"
        Title="Choose new sheet size"
        Width="380" Height="180"
        WindowStartupLocation="CenterOwner" CanResize="False">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Classes="sectionTitle" Text="Choose new sheet size"/>
        <ComboBox x:Name="SizeBox" SelectedIndex="0" HorizontalAlignment="Stretch"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button Classes="primary" Content="OK" Click="Ok_Click" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>
