<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        mc:Ignorable="d"
        x:Class="Assets_Editor.OTBEditor"
        Title="Tibia MultiTool Editor — OTB Editor" Width="1240" Height="880" MinWidth="980" MinHeight="600">
    <Window.Styles>
        <!-- the thumbnail loader assumes rows of exactly 36 px (OTBEditor.LoadVisibleItemImages) -->
        <Style Selector="ListBox#ItemListView > ListBoxItem, ListBox#NewItemListView > ListBoxItem">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}"/>
        </Style>
        <Style Selector="TextBlock.groupTitle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Lg}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Grid.form > CheckBox">
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- ═════  Top bar  ═════ -->
        <Border DockPanel.Dock="Top" Classes="appbar">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <Menu Grid.Column="0" VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="Open..." Click="OpenOTBButton_Click"/>
                        <MenuItem Header="Save" Click="Save_Click"/>
                        <MenuItem Header="Save As..." Click="SaveAs_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="Create missing items" Click="CreateMissingItems"/>
                        <MenuItem Header="Check mismatched items" Click="CheckMisMatcheditems"/>
                        <MenuItem Header="Reload attributes of selected items" Click="ReloadItemsAttr"/>
                    </MenuItem>
                </Menu>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                    <Button x:Name="OpenOTBButton" Classes="tool" Click="OpenOTBButton_Click" ToolTip.Tip="Open items.otb">
                        <StackPanel Orientation="Horizontal" Spacing="6"><i:Icon Value="fa-folder-open"/><TextBlock Text="Open"/></StackPanel>
                    </Button>
                    <Button Classes="primary" Click="Save_Click" ToolTip.Tip="Overwrite the opened items.otb (keeps a one-time -bak)">
                        <StackPanel Orientation="Horizontal" Spacing="6"><i:Icon Value="fa-floppy-disk"/><TextBlock Text="Save"/></StackPanel>
                    </Button>
                    <Button Classes="tool" Click="SaveAs_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6"><i:Icon Value="fa-file-export"/><TextBlock Text="Save as..."/></StackPanel>
                    </Button>
                </StackPanel>
                <TextBox Grid.Column="2" x:Name="OtbPathText" IsEnabled="False" Margin="16,0,0,0" VerticalAlignment="Center"
                         Watermark="No items.otb opened"/>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="240,*,240" Margin="10">

            <!-- ═════  Left: items  ═════ -->
            <Border Grid.Column="0" Classes="card" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Text="Items (server id)" Margin="2,2,0,6"/>
                    <ListBox x:Name="ItemListView" SelectionChanged="ItemListView_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="{Binding Image}" Width="32" Height="32"/>
                                    <TextBlock Text="{Binding Id}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ═════  Middle: selected item  ═════ -->
            <ScrollViewer Grid.Column="1" Margin="10,0">
                <StackPanel Spacing="10">
                    <Border Classes="card" Padding="14">
                        <StackPanel>
                            <TextBlock Classes="groupTitle" Text="Identity"/>
                            <Grid ColumnDefinitions="110,*,20,110,*" RowDefinitions="Auto,6,Auto,6,Auto">
                                <TextBlock Classes="fieldLabel" Text="Server id"/>
                                <NumericUpDown Grid.Column="1" x:Name="I_ServerId" Minimum="0" FormatString="0"/>
                                <TextBlock Grid.Column="3" Classes="fieldLabel" Text="Client id"/>
                                <NumericUpDown Grid.Column="4" x:Name="I_ClientId" Minimum="0" FormatString="0"/>

                                <TextBlock Grid.Row="2" Classes="fieldLabel" Text="Name"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="I_Name"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Classes="fieldLabel" Text="Show as"/>
                                <NumericUpDown Grid.Row="2" Grid.Column="4" x:Name="I_ShowAs" Minimum="0" FormatString="0"/>

                                <TextBlock Grid.Row="4" Classes="fieldLabel" Text="Type"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="I_Type" HorizontalAlignment="Stretch" SelectedIndex="0">
                                    <ComboBoxItem Content="None"/>
                                    <ComboBoxItem Content="Ground"/>
                                    <ComboBoxItem Content="Container"/>
                                    <ComboBoxItem Content="Fluid"/>
                                    <ComboBoxItem Content="Splash"/>
                                    <ComboBoxItem Content="Deprecated"/>
                                    <ComboBoxItem Content="Podium"/>
                                </ComboBox>
                                <TextBlock Grid.Row="4" Grid.Column="3" Classes="fieldLabel" Text="Stack order"/>
                                <ComboBox Grid.Row="4" Grid.Column="4" x:Name="I_StackOrder" HorizontalAlignment="Stretch" SelectedIndex="-1">
                                    <ComboBoxItem Content="None"/>
                                    <ComboBoxItem Content="Border"/>
                                    <ComboBoxItem Content="Bottom"/>
                                    <ComboBoxItem Content="Top"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="14">
                        <StackPanel>
                            <TextBlock Classes="groupTitle" Text="Flags"/>
                            <Grid Classes="form" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <CheckBox Grid.Row="0" Grid.Column="0" x:Name="I_Unpassable" Content="Unpassable"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="I_Movable" Content="Movable"/>
                                <CheckBox Grid.Row="0" Grid.Column="2" x:Name="I_BlockMissiles" Content="Block missiles"/>
                                <CheckBox Grid.Row="0" Grid.Column="3" x:Name="I_BlockPath" Content="Block path"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" x:Name="I_Pickable" Content="Pickupable"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="I_Stackable" Content="Stackable"/>
                                <CheckBox Grid.Row="1" Grid.Column="2" x:Name="I_ForceUse" Content="Force use"/>
                                <CheckBox Grid.Row="1" Grid.Column="3" x:Name="I_MultiUse" Content="Multi use"/>
                                <CheckBox Grid.Row="2" Grid.Column="0" x:Name="I_Rotateable" Content="Rotatable"/>
                                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="I_Hangable" Content="Hangable"/>
                                <CheckBox Grid.Row="2" Grid.Column="2" x:Name="I_HookSouth" Content="Hook south"/>
                                <CheckBox Grid.Row="2" Grid.Column="3" x:Name="I_HookEast" Content="Hook east"/>
                                <CheckBox Grid.Row="3" Grid.Column="0" x:Name="I_Elevation" Content="Elevation"/>
                                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="I_IgnoreLook" Content="Ignore look"/>
                                <CheckBox Grid.Row="3" Grid.Column="2" x:Name="I_Readable" Content="Readable"/>
                                <CheckBox Grid.Row="3" Grid.Column="3" x:Name="I_FullGround" Content="Full ground"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="14">
                        <StackPanel>
                            <TextBlock Classes="groupTitle" Text="Values"/>
                            <Grid ColumnDefinitions="110,*,20,110,*" RowDefinitions="Auto,6,Auto,6,Auto">
                                <TextBlock Classes="fieldLabel" Text="Ground speed"/>
                                <NumericUpDown Grid.Column="1" x:Name="I_GroundSpeed" Minimum="0" Maximum="65535" FormatString="0"/>
                                <TextBlock Grid.Column="3" Classes="fieldLabel" Text="Minimap color"/>
                                <NumericUpDown Grid.Column="4" x:Name="I_MiniMapColor" Minimum="0" FormatString="0"/>

                                <TextBlock Grid.Row="2" Classes="fieldLabel" Text="Light level"/>
                                <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="I_LightLevel" Minimum="0" FormatString="0"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Classes="fieldLabel" Text="Light color"/>
                                <NumericUpDown Grid.Row="2" Grid.Column="4" x:Name="I_LightColor" Minimum="0" FormatString="0"/>

                                <TextBlock Grid.Row="4" Classes="fieldLabel" Text="Max read/write"/>
                                <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="I_MaxReadWriteChars" Minimum="0" FormatString="0"/>
                                <TextBlock Grid.Row="4" Grid.Column="3" Classes="fieldLabel" Text="Max read"/>
                                <NumericUpDown Grid.Row="4" Grid.Column="4" x:Name="I_MaxReadChars" Minimum="0" FormatString="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="SaveItemButton" Classes="primary" HorizontalAlignment="Right" Click="SaveItemButton_Click"
                            ToolTip.Tip="Keep the edits of this item (Save writes items.otb)">
                        <StackPanel Orientation="Horizontal" Spacing="6"><i:Icon Value="fa-check"/><TextBlock Text="Apply to item"/></StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- ═════  Right: created / mismatched  ═════ -->
            <Border Grid.Column="2" Classes="card" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Text="Results" Margin="2,2,0,0"/>
                    <TextBlock DockPanel.Dock="Top" Classes="dim" TextWrapping="Wrap" Margin="2,0,0,6"
                               Text="Items from Edit › Create missing items or Check mismatched items."/>
                    <ListBox x:Name="NewItemListView">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="{Binding Image}" Width="32" Height="32"/>
                                    <TextBlock Text="{Binding Id}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
