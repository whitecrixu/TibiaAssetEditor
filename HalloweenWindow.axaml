<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Assets_Editor.HalloweenWindow"
        Title="Happy Halloween" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False">
    <StackPanel Margin="24" Spacing="10" HorizontalAlignment="Center">
        <!-- jack-o'-lantern, 200 x 180 -->
        <Viewbox Width="200" Height="180" HorizontalAlignment="Center">
            <Canvas Width="200" Height="180">
                <Path Data="M 96,34 C 94,20 100,8 112,4 L 116,10 C 108,14 106,22 108,34 Z" Fill="#4E7A2A"/>
                <Path Data="M 108,18 C 120,10 134,12 142,22 C 130,20 120,22 110,26 Z" Fill="#6B9E3A"/>
                <Ellipse Canvas.Left="10"  Canvas.Top="36" Width="96"  Height="136" Fill="#E8650F"/>
                <Ellipse Canvas.Left="94"  Canvas.Top="36" Width="96"  Height="136" Fill="#E8650F"/>
                <Ellipse Canvas.Left="44"  Canvas.Top="30" Width="112" Height="146" Fill="#FF7A1A"/>
                <Ellipse Canvas.Left="72"  Canvas.Top="32" Width="56"  Height="142" Fill="#FF8C33"/>
                <Path Data="M 58,82 L 86,82 L 72,58 Z" Fill="#2B1405"/>
                <Path Data="M 114,82 L 142,82 L 128,58 Z" Fill="#2B1405"/>
                <Path Data="M 92,104 L 108,104 L 100,90 Z" Fill="#2B1405"/>
                <Path Data="M 46,116 Q 100,168 154,116 L 140,122 L 132,112 L 120,126 L 110,114 L 100,128 L 90,114 L 80,126 L 68,112 L 60,122 Z"
                      Fill="#2B1405"/>
                <Path Data="M 62,78 L 82,78 L 72,62 Z" Fill="#FFC14D" Opacity="0.85"/>
                <Path Data="M 118,78 L 138,78 L 128,62 Z" Fill="#FFC14D" Opacity="0.85"/>
            </Canvas>
        </Viewbox>

        <TextBlock Text="Happy Halloween!" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource SemiColorPrimary}"/>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Classes="dim"
                   Text="The editor wears its Halloween costume until 3 November. You can switch to the light or dark theme on the main screen at any time."/>

        <CheckBox x:Name="DontShowAgain" Content="Don't show this again this year" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        <Button Classes="primary" Content="Boo! Let's edit" HorizontalAlignment="Center" Click="Close_Click"/>
    </StackPanel>
</Window>
