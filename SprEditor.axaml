<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Assets_Editor.SprEditor"
        Title="Tibia MultiTool Editor — Sprite Editor" Width="900" Height="680">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Sheet Viewer -->
        <StackPanel Grid.Column="0">
            <Border Classes="card" Margin="10,10,10,0">
                <StackPanel>
                    <TextBlock Classes="panelHeader" Text="Current Sheet Viewer" HorizontalAlignment="Center"/>
                    <WrapPanel x:Name="SheetWrap" Width="400" Height="400" Background="#FFEAEAEA"
                               DragDrop.AllowDrop="True"/>
                </StackPanel>
            </Border>
            <Border Classes="card" Height="30" Margin="10,10,10,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="💾" Width="35" Height="25" ToolTip.Tip="Save to assets" Click="ImportSheet_Click"/>
                    <Button Content="📤" Width="35" Height="25" ToolTip.Tip="Export Sheet as PNG" Click="ExportSheet_Click"/>
                    <Button Content="📥" Width="35" Height="25" ToolTip.Tip="Import PNG as new sheet" Click="ImportPngAsSheet_Click"/>
                    <Button Content="📂" Width="35" Height="25" ToolTip.Tip="Import multiple PNG sprites into the current sheet" Click="ImportManyIntoSheet_Click"/>
                    <Button Content="🖼" Width="35" Height="25" ToolTip.Tip="Export focused sprite as PNG (hover a tile, then click). Tip: right-click a tile for the same action." Click="ExportSingleSprite_Click"/>
                    <Button Content="🔽" Width="35" Height="25" ToolTip.Tip="Batch downscale a folder of PNGs to 32×32 (nearest-neighbor, keeps pixel art crisp)" Click="BatchDownscale_Click"/>
                    <Separator Width="1" Margin="4,0"/>
                    <Button Content="🗑" Width="35" Height="25" ToolTip.Tip="Delete selected sprites (select with Ctrl+Click / Shift+Click, or Ctrl+A for all)" Click="DeleteSelected_Click"/>
                    <Separator Width="1" Margin="4,0"/>
                    <ToggleButton x:Name="GridOverlayToggle" Content="⊞" Width="35" Height="25"
                                  ToolTip.Tip="Toggle grid overlay on the sheet viewer"
                                  IsCheckedChanged="GridOverlayToggle_Changed"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,6,10,0" Spacing="8">
                <TextBlock x:Name="SprStatusText" VerticalAlignment="Center"/>
                <TextBlock x:Name="TileInfoText" VerticalAlignment="Center" FontSize="11"
                           Foreground="Gray"/>
            </StackPanel>
        </StackPanel>

        <!-- Right: Sheet List -->
        <Border Grid.Column="1" Classes="card" Margin="0,10,10,10">
            <Grid RowDefinitions="Auto,*,30">
                <StackPanel Grid.Row="0" Margin="5">
                    <TextBlock Text="Search Sprite Sheet" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <NumericUpDown x:Name="A_SearchSprId" Width="180" Minimum="1" FormatString="0"/>
                        <Button Content="🔍" Width="35" Height="25" Click="SearchSpr_Click"/>
                    </StackPanel>
                    <TextBlock Text="Export Sprite Range" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <NumericUpDown x:Name="A_ExportRangeFrom" Width="150" Minimum="1" FormatString="0"/>
                        <TextBlock Text="To" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <NumericUpDown x:Name="A_ExportRangeTo" Width="150" Minimum="1" FormatString="0"/>
                        <Button Content="📤" Width="35" Height="25" ToolTip.Tip="Export every sprite ID in the range as individual PNG files" Click="ExportSpriteRange_Click"/>
                    </StackPanel>
                    <TextBlock Text="Delete Sprite Range" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <NumericUpDown x:Name="A_DeleteRangeFrom" Width="150" Minimum="1" FormatString="0"/>
                        <TextBlock Text="To" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <NumericUpDown x:Name="A_DeleteRangeTo" Width="150" Minimum="1" FormatString="0"/>
                        <Button Content="🗑" Width="35" Height="25" ToolTip.Tip="Delete every sprite ID in the range (clears from sheets, SprLists and catalog)" Click="DeleteSpriteRange_Click"/>
                    </StackPanel>
                </StackPanel>
                <ListBox Grid.Row="1" x:Name="SheetsList" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Id}" HorizontalAlignment="Center"/>
                                <Image Source="{Binding Image}" Width="192" Stretch="Fill"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="➕" Width="35" Height="25" ToolTip.Tip="Create New Sheet" Click="CreateSheet_Click"/>
                    <Button Content="✏" Width="35" Height="25" ToolTip.Tip="Edit Sheet" Click="EditSheet_Click"/>
                    <Button Content="🗑" Width="35" Height="25" ToolTip.Tip="Delete selected sheet" Click="DeleteSheet_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
