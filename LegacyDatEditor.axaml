<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:local="clr-namespace:Assets_Editor"
        mc:Ignorable="d"
        x:Class="Assets_Editor.LegacyDatEditor"
        Title="Tibia MultiTool Editor — Legacy DAT" Width="1360" Height="900" MinWidth="1100" MinHeight="640">
    <Window.Styles>
        <!-- one flag per row: checkbox in the first column, its value (if any) in the second -->
        <Style Selector="Grid.flagRow">
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style Selector="Grid.flagRow > CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- the thumbnail loader computes visible rows from the scroll offset: every row must be exactly
             ItemHeight (76) tall, margins included (the theme's 1 px item margin made them 74) -->
        <Style Selector="ListBox#ObjListView > ListBoxItem, ListBox#SprListView > ListBoxItem">
            <Setter Property="Height" Value="76"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Border.flagGroup CheckBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.flagGroup">
            <Setter Property="Width" Value="340"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="TextBlock.groupTitle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Lg}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}"/>
        </Style>
        <Style Selector="Grid.formRow">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style Selector="Grid.formRow > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.labeled">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
    </Window.Styles>

    <DockPanel x:Name="EditorRoot">
        <!-- ═════  Top bar: menu + main actions  ═════ -->
        <Border DockPanel.Dock="Top" Classes="appbar">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Menu Grid.Column="0" VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="Compile to client files" Click="Compile_Click"/>
                        <MenuItem Header="Import from another client / OBD..." Click="Import_Click"/>
                        <Separator/>
                        <MenuItem Header="Exit" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Tools">
                        <MenuItem Header="Search items..." Click="SearchItem_Click"/>
                        <MenuItem Header="OTB editor" Click="OTBEditor_Click"/>
                        <MenuItem Header="Lua script editor" Click="OpenLuaWindow_Click"/>
                        <MenuItem Header="Logger" Click="ShowLogger"/>
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="About" Click="About_Click"/>
                    </MenuItem>
                </Menu>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                    <Button Classes="primary" Click="Compile_Click"
                            ToolTip.Tip="Write Tibia.dat (and Tibia.spr when sprites changed) into the client folder">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="fa-hammer"/>
                            <TextBlock Text="Compile"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Click="Import_Click" ToolTip.Tip="Import objects from another client or an .obd file">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="fa-file-import"/>
                            <TextBlock Text="Import"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Click="SearchItem_Click" ToolTip.Tip="Find objects by flags">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="fa-magnifying-glass"/>
                            <TextBlock Text="Search"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Click="OTBEditor_Click" ToolTip.Tip="Server items.otb">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="fa-database"/>
                            <TextBlock Text="OTB"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Light" Classes="dim" VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="DarkModeToggle" IsCheckedChanged="DarkModeToggle_Changed" OffContent="" OnContent=""/>
                    <TextBlock Text="Dark" Classes="dim" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════  Status bar  ═════ -->
        <Border DockPanel.Dock="Bottom" Classes="statusbar">
            <TextBlock x:Name="StatusBar" Classes="dim" Text="Ready"/>
        </Border>

        <Grid ColumnDefinitions="260,*,250" Margin="10">

            <!-- ═════  Left: objects  ═════ -->
            <Border Grid.Column="0" Classes="card" Padding="8">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <ComboBox Grid.Row="0" x:Name="ObjectMenu" HorizontalAlignment="Stretch" SelectedIndex="0"
                              SelectionChanged="ObjectMenuChanged">
                        <ComboBoxItem Content="Outfits"/>
                        <ComboBoxItem Content="Items"/>
                        <ComboBoxItem Content="Effects"/>
                        <ComboBoxItem Content="Missiles"/>
                    </ComboBox>
                    <!-- row height fixed to 76 by the ListBoxItem style above (LegacyDatEditor.ItemHeight) -->
                    <ListBox Grid.Row="1" x:Name="ObjListView" SelectionChanged="ObjListView_SelectionChanged" Margin="0,6,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" Width="64" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Image Source="{Binding Image}" Width="64" Height="64"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                        <TextBlock Classes="fieldLabel" Text="Go to #"/>
                        <NumericUpDown Grid.Column="1" x:Name="ObjListViewSelectedIndex" Minimum="0" FormatString="0"
                                       ValueChanged="ObjListViewSelectedIndex_Changed"
                                       ToolTip.Tip="Position in the list (items start at id 100)"/>
                    </Grid>
                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Classes="labeled" Click="NewObject_Click" ToolTip.Tip="Add a new empty object at the end">
                            <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-plus"/><TextBlock Text="New"/></StackPanel>
                        </Button>
                        <Button Classes="labeled" Click="ObjectClone_Click" ToolTip.Tip="Duplicate the selected object at the end">
                            <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-clone"/><TextBlock Text="Duplicate"/></StackPanel>
                        </Button>
                        <Button Classes="labeled" Click="DeleteObject_Click" ToolTip.Tip="Delete the last object, or clear any other one (ids are positions)">
                            <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-trash-can"/><TextBlock Text="Delete"/></StackPanel>
                        </Button>
                        <Button Classes="labeled" Click="CopyFlags_Click" ToolTip.Tip="Copy the flags of the selected object">
                            <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-copy"/><TextBlock Text="Copy flags"/></StackPanel>
                        </Button>
                        <Button Classes="labeled" Click="PasteFlags_Click" ToolTip.Tip="Paste copied flags (market trade/show-as ids are kept)">
                            <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-paste"/><TextBlock Text="Paste flags"/></StackPanel>
                        </Button>
                        <Button Classes="labeled" Click="ExportObject_Click" ToolTip.Tip="Save the object picture as PNG">
                            <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-file-export"/><TextBlock Text="Export PNG"/></StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ═════  Middle: selected object  ═════ -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="10,0">
                <Border Grid.Row="0" Classes="hero" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Classes="spriteSlot" Width="72" Height="72" Margin="0,0,12,0">
                            <Image x:Name="ObjectThumbnail" Stretch="Uniform" MaxWidth="64" MaxHeight="64"
                                   RenderOptions.BitmapInterpolationMode="None"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="ObjectTitle" Text="No object selected" FontSize="{StaticResource Font.Xl}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ObjectSubtitle" Classes="dim" Text="Pick an object on the left." TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center" Click="ObjectSave_Click"
                                ToolTip.Tip="Keep the edits of this object (Compile writes them to the client files)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:Icon Value="fa-floppy-disk"/>
                                <TextBlock Text="Save object"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1">
                    <!-- ───── Flags ───── -->
                    <TabItem Header="Flags">
                        <ScrollViewer>
                            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">

                                <Border Classes="card flagGroup">
                                    <StackPanel>
                                        <TextBlock Classes="groupTitle" Text="Ground &amp; layering"/>
                                        <Grid Classes="flagRow" ColumnDefinitions="150,*">
                                            <CheckBox x:Name="A_FlagGround" Content="Ground"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Classes="fieldLabel" Text="Speed"/>
                                                <NumericUpDown x:Name="A_FlagGroundSpeed" Width="110" Minimum="0" Maximum="65535" FormatString="0"/>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="A_FlagFullGround" Content="Full ground"/>
                                        <CheckBox x:Name="A_FlagClip" Content="Clip (border)"/>
                                        <CheckBox x:Name="A_FlagBottom" Content="Bottom"/>
                                        <CheckBox x:Name="A_FlagTop" Content="Top"/>
                                        <Grid Classes="flagRow" ColumnDefinitions="150,*">
                                            <CheckBox x:Name="A_FlagHeight" Content="Elevation"/>
                                            <NumericUpDown Grid.Column="1" x:Name="A_FlagElevation" Width="110" HorizontalAlignment="Left" Minimum="0" Maximum="65535" FormatString="0"/>
                                        </Grid>
                                        <Grid Classes="flagRow" ColumnDefinitions="150,*">
                                            <CheckBox x:Name="A_FlagShift" Content="Displacement"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Classes="fieldLabel" Text="X"/>
                                                <NumericUpDown x:Name="A_FlagShiftX" Width="70" Minimum="-32768" Maximum="32767" FormatString="0"/>
                                                <TextBlock Classes="fieldLabel" Text="Y" Margin="8,0,6,0"/>
                                                <NumericUpDown x:Name="A_FlagShiftY" Width="70" Minimum="-32768" Maximum="32767" FormatString="0"/>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="A_FlagLyingObject" Content="Lying object"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card flagGroup">
                                    <StackPanel>
                                        <TextBlock Classes="groupTitle" Text="Use &amp; content"/>
                                        <CheckBox x:Name="A_FlagContainer" Content="Container"/>
                                        <CheckBox x:Name="A_FlagCumulative" Content="Stackable (cumulative)"/>
                                        <CheckBox x:Name="A_FlagUsable" Content="Usable"/>
                                        <CheckBox x:Name="A_FlagForceuse" Content="Force use"/>
                                        <CheckBox x:Name="A_FlagMultiuse" Content="Multi use"/>
                                        <Grid Classes="flagRow" ColumnDefinitions="150,*">
                                            <CheckBox x:Name="A_FlagWrite" Content="Writable"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Classes="fieldLabel" Text="Max chars"/>
                                                <NumericUpDown x:Name="A_FlagMaxTextLength" Width="100" Minimum="0" Maximum="65535" FormatString="0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Classes="flagRow" ColumnDefinitions="150,*">
                                            <CheckBox x:Name="A_FlagWriteOnce" Content="Write once"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Classes="fieldLabel" Text="Max chars"/>
                                                <NumericUpDown x:Name="A_FlagMaxTextLengthOnce" Width="100" Minimum="0" Maximum="65535" FormatString="0"/>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="A_FlagLiquidcontainer" Content="Liquid container"/>
                                        <CheckBox x:Name="A_FlagLiquidpool" Content="Liquid pool (splash)"/>
                                        <CheckBox x:Name="A_FlagRotate" Content="Rotatable"/>
                                        <Grid Classes="flagRow" ColumnDefinitions="150,*">
                                            <CheckBox x:Name="A_FlagDefaultAction" Content="Default action"/>
                                            <ComboBox Grid.Column="1" x:Name="A_FlagDefaultActionType" Width="140" SelectedIndex="-1">
                                                <ComboBoxItem Content="None"/>
                                                <ComboBoxItem Content="Look"/>
                                                <ComboBoxItem Content="Use"/>
                                                <ComboBoxItem Content="Open"/>
                                                <ComboBoxItem Content="Highlight"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card flagGroup">
                                    <StackPanel>
                                        <TextBlock Classes="groupTitle" Text="Movement &amp; blocking"/>
                                        <CheckBox x:Name="A_FlagUnpass" Content="Not walkable"/>
                                        <CheckBox x:Name="A_FlagUnmove" Content="Not movable"/>
                                        <CheckBox x:Name="A_FlagUnsight" Content="Blocks missiles / sight"/>
                                        <CheckBox x:Name="A_FlagAvoid" Content="Blocks pathfinding"/>
                                        <CheckBox x:Name="A_FlagTake" Content="Pickupable"/>
                                        <CheckBox x:Name="A_FlagHang" Content="Hangable"/>
                                        <Grid ColumnDefinitions="150,*" MinHeight="30">
                                            <CheckBox x:Name="A_FlagHookSouth" Content="Hook south" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="1" x:Name="A_FlagHookEast" Content="Hook east" VerticalAlignment="Center"/>
                                        </Grid>
                                        <CheckBox x:Name="A_FlagNoMoveAnimation" Content="No movement animation"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card flagGroup">
                                    <StackPanel>
                                        <TextBlock Classes="groupTitle" Text="Display"/>
                                        <Grid Classes="flagRow" ColumnDefinitions="150,*">
                                            <CheckBox x:Name="A_FlagLight" Content="Light"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Classes="fieldLabel" Text="Level"/>
                                                <NumericUpDown x:Name="A_FlagLightBrightness" Width="64" Minimum="0" Maximum="255" FormatString="0"/>
                                                <TextBlock Classes="fieldLabel" Text="Color" Margin="8,0,6,0"/>
                                                <NumericUpDown x:Name="A_FlagLightColor" Width="64" Minimum="0" Maximum="215" FormatString="0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Classes="flagRow" ColumnDefinitions="150,*">
                                            <CheckBox x:Name="A_FlagAutomap" Content="Minimap color"/>
                                            <NumericUpDown Grid.Column="1" x:Name="A_FlagAutomapColor" Width="110" HorizontalAlignment="Left" Minimum="0" Maximum="215" FormatString="0"/>
                                        </Grid>
                                        <CheckBox x:Name="A_FlagAnimateAlways" Content="Always animated"/>
                                        <CheckBox x:Name="A_FlagDontHide" Content="Always seen (don't hide)"/>
                                        <CheckBox x:Name="A_FlagTranslucent" Content="Translucent"/>
                                        <CheckBox x:Name="A_FlagIgnoreLook" Content="Ignore look"/>
                                        <CheckBox x:Name="A_FlagTopeffect" Content="Top effect"/>
                                        <CheckBox x:Name="A_FlagWearout" Content="Show charges"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card flagGroup">
                                    <StackPanel>
                                        <TextBlock Classes="groupTitle" Text="Info &amp; market"/>
                                        <Grid Classes="flagRow" ColumnDefinitions="150,*">
                                            <CheckBox x:Name="A_FlagLenshelp" Content="Lens help"/>
                                            <ComboBox Grid.Column="1" x:Name="A_FlagLenshelpId" Width="150" SelectedIndex="-1">
                                                <ComboBoxItem Content="Ladders"/>
                                                <ComboBoxItem Content="Sewer Grates"/>
                                                <ComboBoxItem Content="Dungeon Floor"/>
                                                <ComboBoxItem Content="Levers"/>
                                                <ComboBoxItem Content="Doors"/>
                                                <ComboBoxItem Content="Special Doors"/>
                                                <ComboBoxItem Content="Stairs"/>
                                                <ComboBoxItem Content="Mailboxes"/>
                                                <ComboBoxItem Content="Depot Boxes"/>
                                                <ComboBoxItem Content="Dustbins"/>
                                                <ComboBoxItem Content="Stone Piles"/>
                                                <ComboBoxItem Content="Signs"/>
                                                <ComboBoxItem Content="Books"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Classes="flagRow" ColumnDefinitions="150,*">
                                            <CheckBox x:Name="A_FlagClothes" Content="Clothes slot"/>
                                            <ComboBox Grid.Column="1" x:Name="A_FlagClothesSlot" Width="150" SelectedIndex="-1">
                                                <ComboBoxItem Content="None"/>
                                                <ComboBoxItem Content="Helmet"/>
                                                <ComboBoxItem Content="Amulet"/>
                                                <ComboBoxItem Content="Backpack"/>
                                                <ComboBoxItem Content="Armor"/>
                                                <ComboBoxItem Content="Shield"/>
                                                <ComboBoxItem Content="Weapon"/>
                                                <ComboBoxItem Content="Legs"/>
                                                <ComboBoxItem Content="Boots"/>
                                                <ComboBoxItem Content="Ring"/>
                                                <ComboBoxItem Content="Arrow"/>
                                                <ComboBoxItem Content="Slot 11"/>
                                                <ComboBoxItem Content="Slot 12"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Classes="flagRow" ColumnDefinitions="150,*">
                                            <CheckBox x:Name="A_FlagMarket" Content="Market"/>
                                            <ComboBox Grid.Column="1" x:Name="A_FlagMarketCategory" Width="150" SelectedIndex="-1">
                                                <ComboBoxItem Content="Armors"/>
                                                <ComboBoxItem Content="Amulets"/>
                                                <ComboBoxItem Content="Boots"/>
                                                <ComboBoxItem Content="Containers"/>
                                                <ComboBoxItem Content="Decoration"/>
                                                <ComboBoxItem Content="Food"/>
                                                <ComboBoxItem Content="Helmets/Hats"/>
                                                <ComboBoxItem Content="Legs"/>
                                                <ComboBoxItem Content="Others"/>
                                                <ComboBoxItem Content="Potions"/>
                                                <ComboBoxItem Content="Rings"/>
                                                <ComboBoxItem Content="Runes"/>
                                                <ComboBoxItem Content="Shields"/>
                                                <ComboBoxItem Content="Tools"/>
                                                <ComboBoxItem Content="Valuables"/>
                                                <ComboBoxItem Content="Ammunition"/>
                                                <ComboBoxItem Content="Axes"/>
                                                <ComboBoxItem Content="Clubs"/>
                                                <ComboBoxItem Content="Distance Weapons"/>
                                                <ComboBoxItem Content="Swords"/>
                                                <ComboBoxItem Content="Wands/Rods"/>
                                                <ComboBoxItem Content="Premium Scrolls"/>
                                                <ComboBoxItem Content="Tibia Coins"/>
                                                <ComboBoxItem Content="Creature Products"/>
                                                <ComboBoxItem Content="Quiver"/>
                                                <ComboBoxItem Content="Soul Cores"/>
                                                <ComboBoxItem Content="Fist Weapons"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Classes="flagRow" ColumnDefinitions="150,*">
                                            <TextBlock Classes="fieldLabel" Text="Market name" Margin="28,0,6,0"/>
                                            <TextBox Grid.Column="1" x:Name="A_FlagName"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="150,*" MinHeight="30">
                                            <CheckBox x:Name="A_FlagWrap" Content="Wrappable" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="1" x:Name="A_FlagUnwrap" Content="Unwrappable" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ───── Texture ───── -->
                    <TabItem Header="Texture">
                        <ScrollViewer>
                            <StackPanel Margin="0,8,0,0" Spacing="12">
                                <WrapPanel Orientation="Horizontal">
                                    <!-- preview -->
                                    <Border Classes="card" Width="320" Margin="0,0,12,12" VerticalAlignment="Top">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="groupTitle" Text="Preview"/>
                                            <Grid Width="270" Height="270" HorizontalAlignment="Center">
                                                <Border Classes="spriteSlot" Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image x:Name="SpriteViewerImge" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None"/>
                                                </Border>
                                                <Button x:Name="SprUpArrow" Tag="0" Content="▲" Classes="icon" Width="30" Height="30" Click="ChangeDirection" HorizontalAlignment="Center" VerticalAlignment="Top" ToolTip.Tip="Face north"/>
                                                <Button x:Name="SprRightArrow" Tag="1" Content="▶" Classes="icon" Width="30" Height="30" Click="ChangeDirection" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="Face east"/>
                                                <Button x:Name="SprDownArrow" Tag="2" Content="▼" Classes="icon" Width="30" Height="30" Click="ChangeDirection" HorizontalAlignment="Center" VerticalAlignment="Bottom" ToolTip.Tip="Face south"/>
                                                <Button x:Name="SprLeftArrow" Tag="3" Content="◀" Classes="icon" Width="30" Height="30" Click="ChangeDirection" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip.Tip="Face west"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Classes="fieldLabel" Text="Frame"/>
                                                <Slider Grid.Column="1" x:Name="SprFramesSlider" IsSnapToTickEnabled="True" TickFrequency="1" Minimum="0" Maximum="0" ValueChanged="SprFramesSlider_ValueChanged"/>
                                                <TextBlock Grid.Column="2" x:Name="SprFrameLabel" Text="1/1" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Button x:Name="PlayAnimationButton" Content="▶ Play" Width="90" Click="PlayAnimation_Click" ToolTip.Tip="Play the animation with its frame durations"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Classes="fieldLabel" Text="Group"/>
                                                    <ComboBox x:Name="FrameGroupSelector" Width="130" SelectionChanged="FrameGroupSelector_Changed" ToolTip.Tip="Outfit frame group (idle / moving)"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- size -->
                                    <Border Classes="card" Width="300" Margin="0,0,12,12" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Classes="groupTitle" Text="Size &amp; patterns"/>
                                            <Grid Classes="formRow" ColumnDefinitions="110,*"><TextBlock Text="Width (tiles)"/><NumericUpDown Grid.Column="1" x:Name="A_SprWidth" Minimum="1" Maximum="255" FormatString="0"/></Grid>
                                            <Grid Classes="formRow" ColumnDefinitions="110,*"><TextBlock Text="Height (tiles)"/><NumericUpDown Grid.Column="1" x:Name="A_SprHeight" Minimum="1" Maximum="255" FormatString="0"/></Grid>
                                            <Grid Classes="formRow" ColumnDefinitions="110,*"><TextBlock Text="Layers"/><NumericUpDown Grid.Column="1" x:Name="A_SprLayers" Minimum="1" Maximum="255" FormatString="0"/></Grid>
                                            <Grid Classes="formRow" ColumnDefinitions="110,*"><TextBlock Text="Pattern X"/><NumericUpDown Grid.Column="1" x:Name="A_SprPaternX" Minimum="1" Maximum="255" FormatString="0"/></Grid>
                                            <Grid Classes="formRow" ColumnDefinitions="110,*"><TextBlock Text="Pattern Y"/><NumericUpDown Grid.Column="1" x:Name="A_SprPaternY" Minimum="1" Maximum="255" FormatString="0"/></Grid>
                                            <Grid Classes="formRow" ColumnDefinitions="110,*"><TextBlock Text="Pattern Z"/><NumericUpDown Grid.Column="1" x:Name="A_SprPaternZ" Minimum="1" Maximum="255" FormatString="0"/></Grid>
                                            <Grid Classes="formRow" ColumnDefinitions="110,*"><TextBlock Text="Frames"/><NumericUpDown Grid.Column="1" x:Name="A_SprAnimation" Minimum="1" Maximum="255" FormatString="0"/></Grid>
                                            <Button Content="Apply size" Margin="0,8,0,0" Click="ApplyTextureSize_Click"
                                                    ToolTip.Tip="Resize the sprite list; existing sprites keep their slot. Also applied on Save object."/>
                                        </StackPanel>
                                    </Border>

                                    <!-- animation -->
                                    <Border x:Name="AnimationPanel" Classes="card" Width="320" Margin="0,0,12,12" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock x:Name="AnimationPanelTitle" Classes="groupTitle" Text="Animation" TextWrapping="Wrap"/>
                                            <Grid Classes="formRow" ColumnDefinitions="110,*">
                                                <TextBlock Text="Mode"/>
                                                <ComboBox Grid.Column="1" x:Name="AnimModeSelector" HorizontalAlignment="Stretch" SelectionChanged="AnimationField_Changed">
                                                    <ComboBoxItem Content="Asynchronized"/>
                                                    <ComboBoxItem Content="Synchronized"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid Classes="formRow" ColumnDefinitions="110,*">
                                                <TextBlock Text="Loop count"/>
                                                <NumericUpDown Grid.Column="1" x:Name="AnimLoopCount" Minimum="0" Maximum="4294967295" FormatString="0" ValueChanged="AnimationValue_Changed" ToolTip.Tip="0 = infinite, 4294967295 = ping-pong"/>
                                            </Grid>
                                            <Grid Classes="formRow" ColumnDefinitions="110,*">
                                                <TextBlock Text="Start phase"/>
                                                <NumericUpDown Grid.Column="1" x:Name="AnimStartPhase" Minimum="0" Maximum="255" FormatString="0" ValueChanged="AnimationValue_Changed"/>
                                            </Grid>
                                            <Grid Classes="formRow" ColumnDefinitions="110,*">
                                                <TextBlock x:Name="PhaseLabel" Text="Phase 1 (ms)" TextWrapping="Wrap"/>
                                                <Grid Grid.Column="1" ColumnDefinitions="*,6,*">
                                                    <NumericUpDown x:Name="PhaseDurationMin" Minimum="0" Maximum="4294967295" FormatString="0" ValueChanged="AnimationValue_Changed" ToolTip.Tip="Minimum duration"/>
                                                    <NumericUpDown Grid.Column="2" x:Name="PhaseDurationMax" Minimum="0" Maximum="4294967295" FormatString="0" ValueChanged="AnimationValue_Changed" ToolTip.Tip="Maximum duration"/>
                                                </Grid>
                                            </Grid>
                                            <Button Content="Use this duration for all phases" Margin="0,8,0,0" Click="ApplyDurationToAllPhases_Click"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <!-- slots -->
                                <Border Classes="card" Margin="0,0,12,12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="groupTitle" Text="Sprite slots (current frame group and frame)"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBlock Classes="fieldLabel" Text="Layer"/>
                                            <NumericUpDown x:Name="SlotLayer" Width="80" Minimum="0" Maximum="0" Value="0" FormatString="0" ValueChanged="SlotView_Changed" Margin="0,0,12,0"/>
                                            <TextBlock Classes="fieldLabel" Text="Pattern X"/>
                                            <NumericUpDown x:Name="SlotPatternX" Width="80" Minimum="0" Maximum="0" Value="0" FormatString="0" ValueChanged="SlotView_Changed" Margin="0,0,12,0"/>
                                            <TextBlock Classes="fieldLabel" Text="Y"/>
                                            <NumericUpDown x:Name="SlotPatternY" Width="80" Minimum="0" Maximum="0" Value="0" FormatString="0" ValueChanged="SlotView_Changed" Margin="0,0,12,0"/>
                                            <TextBlock Classes="fieldLabel" Text="Z"/>
                                            <NumericUpDown x:Name="SlotPatternZ" Width="80" Minimum="0" Maximum="0" Value="0" FormatString="0" ValueChanged="SlotView_Changed"/>
                                        </WrapPanel>
                                        <Border Classes="spriteSlot" HorizontalAlignment="Left" Padding="4">
                                            <Grid x:Name="SlotGrid"/>
                                        </Border>
                                        <TextBlock x:Name="SlotInfo" Classes="dim" TextWrapping="Wrap"
                                                   Text="Select a slot, then double-click a sprite in the sprite list (or drag it onto the slot)."/>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="labeled" Click="AssignSpriteToSlot_Click" ToolTip.Tip="Put the sprite selected on the right into the selected slot">
                                                <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-hand-pointer"/><TextBlock Text="Assign selected sprite"/></StackPanel>
                                            </Button>
                                            <Button Classes="labeled" Click="ClearSlot_Click" ToolTip.Tip="Set the selected slot to sprite 0 (empty)">
                                                <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-eraser"/><TextBlock Text="Clear slot"/></StackPanel>
                                            </Button>
                                            <Button Classes="labeled" Click="ImportImageToObject_Click" ToolTip.Tip="Split an image (sides multiple of 32) into new sprites and put them into these slots">
                                                <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-image"/><TextBlock Text="Import image..."/></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ───── Raw data ───── -->
                    <TabItem Header="Raw data">
                        <TextBox x:Name="A_FullInfo" Margin="0,8,0,0" TextWrapping="Wrap" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="monospace, Consolas, Menlo" FontSize="{StaticResource Font.Sm}"/>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ═════  Right: sprites  ═════ -->
            <Border Grid.Column="2" Classes="card" Padding="8">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Row="0" Classes="groupTitle" Text="Sprites" Margin="2,4,0,0"/>
                    <ListBox Grid.Row="1" x:Name="SprListView" Margin="0,6,0,0" DoubleTapped="SprListView_DoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" Width="72" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Image Source="{Binding Image}" Width="64" Height="64"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                        <TextBlock Classes="fieldLabel" Text="Go to #"/>
                        <NumericUpDown Grid.Column="1" x:Name="SprListViewSelectedIndex" Minimum="0" FormatString="0" ValueChanged="SprListViewSelectedIndex_Changed"/>
                    </Grid>
                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Classes="labeled" Click="AddSprite_Click" ToolTip.Tip="Add an empty sprite at the end">
                            <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-plus"/><TextBlock Text="Add"/></StackPanel>
                        </Button>
                        <Button Classes="labeled" Click="ImportSprite_Click" ToolTip.Tip="Add image files (split into 32×32 tiles) as new sprites">
                            <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-file-import"/><TextBlock Text="Import"/></StackPanel>
                        </Button>
                        <Button Classes="labeled" Click="ReplaceSprite_Click" ToolTip.Tip="Replace the selected sprite with a 32×32 image">
                            <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-arrows-rotate"/><TextBlock Text="Replace"/></StackPanel>
                        </Button>
                        <Button Classes="labeled" Click="SpriteExport_Click" ToolTip.Tip="Save the selected sprite as PNG">
                            <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-file-export"/><TextBlock Text="Export"/></StackPanel>
                        </Button>
                        <Button Classes="labeled" Click="DeleteSprite_Click" ToolTip.Tip="Clear the selected sprite (it becomes empty)">
                            <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="fa-trash-can"/><TextBlock Text="Delete"/></StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
