<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Assets_Editor.ImportManager"
        Title="Import Manager" Width="800" Height="860">
    <Grid>
        <TabControl>
            <TabItem Header="Import From Client">
                <Grid RowDefinitions="60,20,20,*">
                    <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Center" Margin="5,10,5,5">
                        <TextBlock Text="Client Path:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ClientPathText" Width="300" IsEnabled="False" Margin="5,0,5,0"/>
                        <Button Content="📂" Width="40" Height="40" Click="OpenClient_Click"/>
                    </StackPanel>
                    <CheckBox Grid.Row="1" x:Name="SprTransparent" Content="Transparent" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="LoadProgress" Grid.Row="2" Minimum="0" Maximum="100" Value="0" Margin="50,0,50,5" Height="10"/>
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto" Margin="5,0,5,0">
                        <!-- Object List -->
                        <Border Grid.Column="0" Classes="card" Margin="10,5,0,10">
                            <Grid RowDefinitions="45,*,40,45">
                                <ComboBox Grid.Row="0" x:Name="ObjectMenu" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ObjectMenuChanged">
                                    <ComboBoxItem Content="Outfits"/>
                                    <ComboBoxItem Content="Items"/>
                                    <ComboBoxItem Content="Effects"/>
                                    <ComboBoxItem Content="Missiles"/>
                                </ComboBox>
                                <ListBox Grid.Row="1" x:Name="ObjListView" SelectionChanged="ObjListView_SelectionChanged" Margin="0,5,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Id}" Width="60" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Image}" Width="64" Height="64"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <NumericUpDown Grid.Row="2" x:Name="ObjListViewSelectedIndex" Minimum="0" FormatString="0" Margin="0,5,0,0"/>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                    <Button Content="📥 Import" Width="80" Click="ObjectImport_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Sprite List -->
                        <Border Grid.Column="1" Classes="card" Width="225" Margin="10,5,0,10">
                            <Grid RowDefinitions="Auto,*,40">
                                <TextBlock Grid.Row="0" Classes="panelHeader" Text="Sprite List" HorizontalAlignment="Center"/>
                                <ListBox Grid.Row="1" x:Name="SprListView" Margin="0,5,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Id}" Width="60" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Image}" Width="64" Height="64"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="📥 Import Spr" Width="100" Click="ImportSpr_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- OBD Import -->
                        <Border Grid.Column="2" Classes="card" Width="300" Height="300" Margin="10,5,10,10" VerticalAlignment="Top">
                            <Grid RowDefinitions="Auto,150,50,50">
                                <TextBlock Grid.Row="0" Classes="panelHeader" Text="Import OBD File" HorizontalAlignment="Center"/>
                                <Border Grid.Row="1" Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5,10,10">
                                    <Image x:Name="OBDImage" MinWidth="32" MinHeight="32"/>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Select File:" VerticalAlignment="Center"/>
                                    <Button Content="📂" Width="40" Height="30" Click="ImportObject_Click"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                    <TextBlock Text="View" VerticalAlignment="Center"/>
                                    <Slider x:Name="ObjImportSlider" Width="40" IsSnapToTickEnabled="True" TickFrequency="1" Minimum="0" Maximum="1" Margin="15,0,15,0"/>
                                    <TextBlock Text="Import" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
