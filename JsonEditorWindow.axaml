<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Assets_Editor.JsonEditorWindow"
        Title="JSON Editor"
        Width="600" Height="740"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <TextBlock Grid.Row="0" x:Name="HeaderText" Classes="sectionTitle"/>
        <Border Grid.Row="1" Classes="card" Padding="0">
            <TextBox x:Name="JsonBox"
                     AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Cascadia Mono, Menlo, Consolas, monospace"
                     FontSize="12" TextWrapping="Wrap" Padding="10"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0" Spacing="8">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Classes="dim" Margin="0,0,8,0"/>
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button Classes="primary" Content="Apply JSON" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
