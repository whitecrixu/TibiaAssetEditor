<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Android build (alpha). It compiles the same file-format code as the desktop editor and the tests
    (DatStructure, LegacyAppearance, Sprite, OTB, ItemsXml) against the stand-ins in Host.cs, with a
    single-view UI for phones and tablets. The desktop project excludes this folder.

    Build: dotnet build -c Release -p:AndroidSdkDirectory=~/android-sdk -p:JavaSdkDirectory=<JDK 21>
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <RootNamespace>Assets_Editor</RootNamespace>
    <AssemblyName>TibiaMultiTool</AssemblyName>
    <ApplicationId>com.whitecrixu.tibiamultitool</ApplicationId>
    <ApplicationTitle>Tibia MultiTool</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0-alpha</ApplicationDisplayVersion>
    <Version>0.1.0</Version>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0618;CS0168;CS0219;CA1416;CA1422</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.3.22" />
    <PackageReference Include="Semi.Avalonia" Version="11.3.22" />
    <PackageReference Include="Google.Protobuf" Version="3.21.4" />
    <PackageReference Include="Grpc.Tools" Version="2.60.0" PrivateAssets="All" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
    <!-- SkiaSharp 3 / HarfBuzzSharp 8 ship 16 KB page aligned Android libraries (Android 15+ devices) -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="3.119.4" />
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.5" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Android" Version="8.3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../appearances.proto" GrpcServices="None" Link="appearances.proto" />
    <Compile Include="../DatStructure.cs" Link="Shared/DatStructure.cs" />
    <Compile Include="../LegacyAppearance.cs" Link="Shared/LegacyAppearance.cs" />
    <Compile Include="../Sprite.cs" Link="Shared/Sprite.cs" />
    <Compile Include="../LockBitmap.cs" Link="Shared/LockBitmap.cs" />
    <Compile Include="../OTB/*.cs" LinkBase="Shared/OTB" />
    <Compile Include="../ItemsXml.cs" Link="Shared/ItemsXml.cs" />
    <EmbeddedResource Include="../Appearances.xml" Link="Appearances.xml" LogicalName="Appearances.xml" />
  </ItemGroup>
</Project>
